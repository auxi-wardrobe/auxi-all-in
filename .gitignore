# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Local Claude state (per-user)
.claude/settings.local.json
.claude/state/
.claude/logs/

# Logs / temp
*.log
tmp/
.cache/

# Environment files
.env
.env.local
.env.*.local

# OS-specific
Thumbs.db
ehthumbs.db

# QA boot script artefacts
logs/*
!logs/.gitkeep

# Third-party WebDriverAgent (cloned by scripts/wda-install.sh, not vendored)
tools/wda/WebDriverAgent/

# Git worktrees (working copies, not source)
worktrees/
.claude/worktrees/

# Hook runtime logs (ephemeral per-session)
.claude/hooks/.logs/

# Brainstorming visual companion
.superpowers/

# Playwright MCP session artifacts (console logs + page snapshots)
.playwright-mcp/

# QA / Figma screenshot + capture artifacts (dev byproducts, not source)
plans/**/*.png
plans/**/*.jpg
plans/**/*.jpeg
plans/**/*.gif
plans/**/*.webp
plans/**/*.mp4
plans/**/*.mov

# Python bytecode from .claude/scripts/* helpers
__pycache__/
*.pyc

# Hook run logs — per-session machine state, rewritten on every run.
# Same category as the already-ignored .claude/logs/; versioning it guarantees
# a dirty tree and a conflict on every merge.
.codex/hooks/.logs/

# Agent-team completion logs (written by the team-coordination hook per run)
plans/reports/*-team-completions.md
