@@ -0,0 +1,119 @@
+import { WardrobeItem } from '../../../services/wardrobeService';
+
+/**
+ * Style profile — the five horizontal bars on the Wardrobe Analysis page.
+ *
+ * Unlike the category donut these are NOT a partition: one item can be both
+ * minimal and casual, so the bars are independent shares and are expected to
+ * sum past 100%. Each bar answers "what share of your wardrobe reads as X".
+ */
+export const STYLE_KEYS = [
+  'minimal',
+  'casual',
+  'classic',
+  'soft',
+  'bold',
+] as const;
+
+export type StyleKey = (typeof STYLE_KEYS)[number];
+
+export interface StyleShare {
+  key: StyleKey;
+  count: number;
+  /** Share of all items, 0–100, rounded for display. */
+  percent: number;
+}
+
+/**
+ * Substring keywords matched against an item's `style_tags` and
+ * `formality_level`. Substrings (not equality) so backend variants like
+ * "smart-casual", "minimalist" or "statement-piece" land in the right bucket
+ * without an exhaustive enum the backend never promised to honour.
+ */
+const STYLE_KEYWORDS: Record<StyleKey, string[]> = {
+  minimal: ['minimal', 'basic', 'simple', 'clean', 'neutral', 'essential'],
+  casual: ['casual', 'everyday', 'relaxed', 'sport', 'street', 'weekend'],
+  classic: [
+    'classic',
+    'formal',
+    'business',
+    'smart',
+    'timeless',
+    'elegant',
+    'tailored',
+  ],
+  soft: ['soft', 'romantic', 'feminine', 'pastel', 'cozy', 'delicate', 'flow'],
+  bold: [
+    'bold',
+    'statement',
+    'vibrant',
+    'edgy',
+    'print',
+    'pattern',
+    'bright',
+    'graphic',
+  ],
+};
+
+/**
+ * Control tags the app writes into `style_tags` for its own bookkeeping
+ * (favourite flag, less-used flag, `fit:*` sizing hints). They describe the
+ * user's relationship to the item, not its style, so they must never feed a
+ * style bar — `fit:relaxed` would otherwise register the item as casual.
+ */
+const CONTROL_TAG_PREFIXES = ['fit:'];
+const CONTROL_TAGS = ['favorite', 'favourite', 'less-used'];
+
+const isControlTag = (tag: string): boolean =>
+  CONTROL_TAGS.includes(tag) ||
+  CONTROL_TAG_PREFIXES.some(prefix => tag.startsWith(prefix));
+
+/** The lowercase style vocabulary an item contributes, control tags stripped. */
+const styleVocabulary = (item: WardrobeItem): string[] => {
+  const tags = Array.isArray(item.style_tags) ? item.style_tags : [];
+  const words = tags
+    .filter((tag): tag is string => typeof tag === 'string')
+    .map(tag => tag.trim().toLowerCase())
+    .filter(tag => tag.length > 0 && !isControlTag(tag));
+
+  const formality = item.formality_level?.trim().toLowerCase();
+  return formality ? [...words, formality] : words;
+};
+
+export const matchesStyle = (item: WardrobeItem, key: StyleKey): boolean => {
+  const vocabulary = styleVocabulary(item);
+  return vocabulary.some(word =>
+    STYLE_KEYWORDS[key].some(keyword => word.includes(keyword)),
+  );
+};
+
+/**
+ * All five shares, largest first. Zero-share styles are kept: "you own nothing
+ * bold" is itself a reading of the wardrobe, and dropping the row would make
+ * the chart's height jump around as items are added.
+ */
+export const buildStyleProfile = (items: WardrobeItem[]): StyleShare[] => {
+  if (items.length === 0) {
+    return [];
+  }
+
+  return STYLE_KEYS.map(key => {
+    const count = items.filter(item => matchesStyle(item, key)).length;
+    return {
+      key,
+      count,
+      percent: Math.round((count / items.length) * 100),
+    };
+  }).sort((a, b) => b.count - a.count || STYLE_KEYS.indexOf(a.key) - STYLE_KEYS.indexOf(b.key));
+};
+
+/**
+ * The style the insight card speaks to — the strongest bar, or `null` when no
+ * item carries any style signal at all (a wardrobe of untagged uploads). The
+ * caller renders no card in that case rather than asserting a style the data
+ * doesn't support.
+ */
+export const dominantStyle = (profile: StyleShare[]): StyleKey | null => {
+  const top = profile.find(share => share.count > 0);
+  return top ? top.key : null;
+};
diff --git a/src/screens/wardrobe/analysis/wardrobe-analysis-worn.ts b/src/screens/wardrobe/analysis/wardrobe-analysis-worn.ts
