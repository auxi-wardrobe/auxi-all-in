@@ -0,0 +1,293 @@
+import React, { useEffect, useMemo, useRef, useState } from 'react';
+import { ScrollView, StyleSheet, Text, View } from 'react-native';
+import { SafeAreaView } from 'react-native-safe-area-context';
+import { useIsFocused, useNavigation } from '@react-navigation/native';
+import { NativeStackNavigationProp } from '@react-navigation/native-stack';
+import { useTranslation } from 'react-i18next';
+import { useQuery } from '@tanstack/react-query';
+import { Header } from '../components/layout/Header';
+import { Shimmer } from '../components/features/Shimmer';
+import { theme } from '../theme/theme';
+import { track } from '../services/analytics';
+import { AppStackParamList } from '../types/navigation';
+import {
+  WardrobeItem,
+  wardrobeKeys,
+  wardrobeService,
+} from '../services/wardrobeService';
+import {
+  FAVOURITES_QUERY_KEY,
+  favouriteService,
+} from '../services/favouriteService';
+import {
+  CREATIONS_QUERY_KEY,
+  creationsService,
+} from '../services/creationsService';
+import { HORIZONTAL_PADDING } from './wardrobe/wardrobe-grid';
+import { buildCategoryBalance } from './wardrobe/analysis/wardrobe-analysis-category';
+import {
+  buildStyleProfile,
+  dominantStyle,
+} from './wardrobe/analysis/wardrobe-analysis-style';
+import { buildColorDistribution } from './wardrobe/analysis/wardrobe-analysis-color';
+import { pickWornItems } from './wardrobe/analysis/wardrobe-analysis-worn';
+import { AnalysisSummaryCard } from './wardrobe/analysis/AnalysisSummaryCard';
+import { CategoryBalanceDonut } from './wardrobe/analysis/CategoryBalanceDonut';
+import { StyleProfileBars } from './wardrobe/analysis/StyleProfileBars';
+import { StyleInsightCard } from './wardrobe/analysis/StyleInsightCard';
+import { ColorDistributionStrip } from './wardrobe/analysis/ColorDistributionStrip';
+import { WornItemsRow } from './wardrobe/analysis/WornItemsRow';
+
+type ScreenNavigation = NativeStackNavigationProp<
+  AppStackParamList,
+  'WardrobeAnalysis'
+>;
+
+const Section: React.FC<{ title: string; children: React.ReactNode }> = ({
+  title,
+  children,
+}) => (
+  <View style={styles.section}>
+    <Text style={styles.sectionTitle}>{title}</Text>
+    {children}
+  </View>
+);
+
+/**
+ * Wardrobe Analysis — reached from the "Analysis" chip on the wardrobe grid.
+ *
+ * Every figure on this page is DERIVED on the client from data the app already
+ * holds; there is no analysis endpoint. The item list is read from the same
+ * TanStack cache key the grid uses (`wardrobeKeys.list('All')`), so arriving
+ * from the grid paints instantly and never refetches.
+ */
+export const WardrobeAnalysisScreen: React.FC = () => {
+  const navigation = useNavigation<ScreenNavigation>();
+  const { t } = useTranslation();
+  const isFocused = useIsFocused();
+  const [insightExpanded, setInsightExpanded] = useState(false);
+
+  const wardrobeQuery = useQuery({
+    queryKey: wardrobeKeys.list('All'),
+    queryFn: () => wardrobeService.getWardrobeItems(),
+    staleTime: 60_000,
+  });
+
+  // Same key AND same call as the Favourite page, so the two share one cache
+  // entry. Only `total` is read here; narrowing the request to limit=1 would
+  // save nothing and would poison the Favourite page's list if this screen
+  // populated the cache first.
+  const favouritesQuery = useQuery({
+    queryKey: FAVOURITES_QUERY_KEY,
+    queryFn: () => favouriteService.listFavourites(),
+    staleTime: 60_000,
+  });
+
+  const creationsQuery = useQuery({
+    queryKey: CREATIONS_QUERY_KEY,
+    queryFn: () => creationsService.listCreations(),
+    staleTime: 60_000,
+  });
+
+  const items = useMemo(
+    () => wardrobeQuery.data ?? [],
+    [wardrobeQuery.data],
+  );
+
+  const categoryBalance = useMemo(
+    () => buildCategoryBalance(items),
+    [items],
+  );
+  const styleProfile = useMemo(() => buildStyleProfile(items), [items]);
+  const colorDistribution = useMemo(
+    () => buildColorDistribution(items),
+    [items],
+  );
+  const mostWorn = useMemo(() => pickWornItems(items, 'most'), [items]);
+  const leastWorn = useMemo(() => pickWornItems(items, 'least'), [items]);
+  const insightStyle = useMemo(
+    () => dominantStyle(styleProfile),
+    [styleProfile],
+  );
+
+  const loading = wardrobeQuery.isLoading;
+  const hasItems = items.length > 0;
+
+  // Screen view — fired ONCE per focus, carrying the wardrobe size so the
+  // funnel can separate "opened with 3 items" from "opened with 300".
+  //
+  // The ref is what makes it once-per-focus. `item_count` has to be read at
+  // fire time, but putting it in the dep array would re-fire the event every
+  // time the shared wardrobe cache updates underneath this screen (an upload
+  // completing on another screen, a background revalidate) — inflating the
+  // view count with events the user never caused. The ref latches instead, and
+  // resets when focus is lost so a genuine re-entry counts again.
+  const viewTrackedRef = useRef(false);
+  useEffect(() => {
+    if (!isFocused) {
+      viewTrackedRef.current = false;
+      return;
+    }
+    if (loading || viewTrackedRef.current) {
+      return;
+    }
+    viewTrackedRef.current = true;
+    track('wardrobe_analysis_viewed', { item_count: items.length });
+  }, [isFocused, loading, items.length]);
+
+  const handleToggleInsight = () => {
+    const next = !insightExpanded;
+    setInsightExpanded(next);
+    track('wardrobe_analysis_insight_toggled', {
+      expanded: next,
+      ...(insightStyle ? { style: insightStyle } : {}),
+    });
+  };
+
+  const handleOpenItem = (source: 'most_worn' | 'least_worn') => (
+    item: WardrobeItem,
+  ) => {
+    track('wardrobe_analysis_item_opened', { item_id: item.id, source });
+    navigation.navigate('ItemDetail', { itemId: item.id });
+  };
+
+  return (
+    <SafeAreaView style={styles.container} edges={['top']}>
+      <Header.BackTitle
+        title={t('wardrobe.analysis.title')}
+        leftTestID="wardrobe-analysis-back"
+        leftAccessibilityLabel={t('uac.common.back')}
+        onBack={() => navigation.goBack()}
+      />
+
+      <ScrollView
+        style={styles.scroll}
+        contentContainerStyle={styles.scrollContent}
+        showsVerticalScrollIndicator={false}
+      >
+        {loading ? (
+          <View style={styles.loading} testID="wardrobe-analysis-loading">
+            {/* No explicit width — the shimmers stretch to the padded content
+                column, so the skeleton matches the real sections on any device. */}
+            <Shimmer height={96} />
+            <Shimmer height={180} />
+            <Shimmer height={200} />
+          </View>
+        ) : (
+          <>
+            <AnalysisSummaryCard
+              totalItems={items.length}
+              totalFavourites={favouritesQuery.data?.total ?? 0}
+              totalCreations={creationsQuery.data?.creations.length ?? 0}
+              countsPending={
+                favouritesQuery.isLoading || creationsQuery.isLoading
+              }
+            />
+
+            {!hasItems ? (
+              <View style={styles.empty} testID="wardrobe-analysis-empty">
+                <Text style={styles.emptyTitle}>
+                  {t('wardrobe.analysis.empty_title')}
+                </Text>
+                <Text style={styles.emptyBody}>
+                  {t('wardrobe.analysis.empty_body')}
+                </Text>
+              </View>
+            ) : (
+              <>
+                <Section title={t('wardrobe.analysis.category_balance')}>
+                  <CategoryBalanceDonut
+                    slices={categoryBalance}
+                    total={items.length}
+                  />
+                </Section>
+
+                <Section title={t('wardrobe.analysis.style_profile')}>
+                  <StyleProfileBars profile={styleProfile} />
+                  {insightStyle ? (
+                    <View style={styles.insightWrap}>
+                      <StyleInsightCard
+                        style={insightStyle}
+                        expanded={insightExpanded}
+                        onToggle={handleToggleInsight}
+                      />
+                    </View>
+                  ) : null}
+                </Section>
+
+                {colorDistribution.length > 0 ? (
+                  <Section title={t('wardrobe.analysis.color_distribution')}>
+                    <ColorDistributionStrip
+                      distribution={colorDistribution}
+                    />
+                  </Section>
+                ) : null}
+
+                <Section title={t('wardrobe.analysis.most_worn')}>
+                  <WornItemsRow
+                    entries={mostWorn}
+                    onPressItem={handleOpenItem('most_worn')}
+                    testIDPrefix="wardrobe-analysis-most-worn"
+                  />
+                </Section>
+
+                <Section title={t('wardrobe.analysis.least_worn')}>
+                  <WornItemsRow
+                    entries={leastWorn}
+                    onPressItem={handleOpenItem('least_worn')}
+                    testIDPrefix="wardrobe-analysis-least-worn"
+                  />
+                </Section>
+              </>
+            )}
+          </>
+        )}
+      </ScrollView>
+    </SafeAreaView>
+  );
+};
+
+const styles = StyleSheet.create({
+  container: {
+    flex: 1,
+    backgroundColor: theme.colors.figmaBackground,
+  },
+  scroll: {
+    flex: 1,
+  },
+  scrollContent: {
+    paddingHorizontal: HORIZONTAL_PADDING,
+    paddingTop: 12,
+    paddingBottom: 40,
+  },
+  loading: {
+    gap: 16,
+  },
+  section: {
+    marginTop: 28,
+  },
+  sectionTitle: {
+    ...theme.typography.aliases.poppinsSemiboldSm,
+    color: theme.colors.figmaTextPrimary,
+    marginBottom: 16,
+  },
+  insightWrap: {
+    marginTop: 20,
+  },
+  empty: {
+    paddingTop: 56,
+    alignItems: 'center',
+  },
+  emptyTitle: {
+    ...theme.typography.aliases.poppinsSemiboldSm,
+    color: theme.colors.figmaTextPrimary,
+    textAlign: 'center',
+  },
+  emptyBody: {
+    ...theme.typography.aliases.poppinsBodySm,
+    color: theme.colors.figmaTextSecondary,
+    textAlign: 'center',
+    marginTop: 8,
+    maxWidth: 280,
+  },
+});
