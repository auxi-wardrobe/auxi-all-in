@@ -0,0 +1,76 @@
+import { WardrobeItem } from '../../../../services/wardrobeService';
+import {
+  buildCategoryBalance,
+  classifyCategory,
+} from '../wardrobe-analysis-category';
+
+const item = (id: string, category?: string): WardrobeItem =>
+  ({ id, ...(category ? { category } : {}) } as WardrobeItem);
+
+describe('classifyCategory', () => {
+  test.each([
+    ['T-Shirt', 'top'],
+    ['blouse', 'top'],
+    ['Jeans', 'bottom'],
+    ['midi skirt', 'bottom'],
+    ['Summer Dress', 'one_piece'],
+    ['jumpsuit', 'one_piece'],
+    ['Denim Jacket', 'outerwear'],
+    ['wool coat', 'outerwear'],
+    ['Sneakers', 'shoes'],
+    ['leather belt', 'accessory'],
+  ])('%s → %s', (category, expected) => {
+    expect(classifyCategory(item('x', category))).toBe(expected);
+  });
+
+  test('unknown and missing categories fall through to other', () => {
+    expect(classifyCategory(item('a', 'umbrella'))).toBe('other');
+    expect(classifyCategory(item('b'))).toBe('other');
+  });
+
+  // The synonym lists overlap, so precedence is what keeps the donut summing
+  // to 100 — a blazer-dress must count once, not twice.
+  test('an item matching two families is counted once, most specific wins', () => {
+    expect(classifyCategory(item('c', 'dress coat'))).toBe('one_piece');
+  });
+});
+
+describe('buildCategoryBalance', () => {
+  test('empty wardrobe yields no slices', () => {
+    expect(buildCategoryBalance([])).toEqual([]);
+  });
+
+  test('counts and percentages are of the whole wardrobe, largest first', () => {
+    const items = [
+      item('1', 'shirt'),
+      item('2', 'top'),
+      item('3', 'jeans'),
+      item('4', 'sneakers'),
+    ];
+
+    expect(buildCategoryBalance(items)).toEqual([
+      { key: 'top', count: 2, percent: 50 },
+      { key: 'bottom', count: 1, percent: 25 },
+      { key: 'shoes', count: 1, percent: 25 },
+    ]);
+  });
+
+  test('slice counts always sum to the item total', () => {
+    const items = [
+      item('1', 'shirt'),
+      item('2', 'jacket'),
+      item('3', 'mystery'),
+      item('4', 'dress'),
+    ];
+    const total = buildCategoryBalance(items).reduce(
+      (sum, slice) => sum + slice.count,
+      0,
+    );
+    expect(total).toBe(items.length);
+  });
+
+  test('unrecognised categories surface as `other` rather than vanishing', () => {
+    const balance = buildCategoryBalance([item('1', 'umbrella')]);
+    expect(balance).toEqual([{ key: 'other', count: 1, percent: 100 }]);
+  });
+});
diff --git a/src/screens/wardrobe/analysis/__tests__/wardrobe-analysis-color.test.ts b/src/screens/wardrobe/analysis/__tests__/wardrobe-analysis-color.test.ts
