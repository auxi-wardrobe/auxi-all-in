index 0000000..2145036
--- /dev/null
+++ b/src/screens/wardrobe/analysis/CategoryBalanceDonut.tsx
@@ -0,0 +1,140 @@
+import React from 'react';
+import { StyleSheet, Text, View } from 'react-native';
+import Svg, { Circle, G } from 'react-native-svg';
+import { useTranslation } from 'react-i18next';
+import { theme } from '../../../theme/theme';
+import { CategorySlice } from './wardrobe-analysis-category';
+
+const SIZE = 148;
+const STROKE = 26;
+const RADIUS = (SIZE - STROKE) / 2;
+const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
+
+const PALETTE = theme.ds.color.chart.category;
+
+/** Slice colour by position, wrapping if a wardrobe ever exceeds the ramp. */
+export const sliceColor = (index: number): string =>
+  PALETTE[index % PALETTE.length];
+
+interface CategoryBalanceDonutProps {
+  slices: CategorySlice[];
+  total: number;
+}
+
+/**
+ * Category-balance donut + legend.
+ *
+ * Arcs are drawn from raw COUNTS, not from the rounded percentages shown in the
+ * legend, so the ring always closes exactly even when the printed labels sum to
+ * 99 or 101.
+ */
+export const CategoryBalanceDonut: React.FC<CategoryBalanceDonutProps> = ({
+  slices,
+  total,
+}) => {
+  const { t } = useTranslation();
+
+  // Running offset so each arc starts where the previous one ended. Rotated
+  // -90° by the wrapping <G> so the first slice begins at 12 o'clock.
+  let consumed = 0;
+
+  return (
+    <View style={styles.row} testID="wardrobe-analysis-donut">
+      <View style={styles.chartWrap}>
+        <Svg width={SIZE} height={SIZE}>
+          <G rotation={-90} originX={SIZE / 2} originY={SIZE / 2}>
+            {slices.map((slice, index) => {
+              const length = (slice.count / total) * CIRCUMFERENCE;
+              const offset = -consumed;
+              consumed += length;
+              return (
+                <Circle
+                  key={slice.key}
+                  cx={SIZE / 2}
+                  cy={SIZE / 2}
+                  r={RADIUS}
+                  stroke={sliceColor(index)}
+                  strokeWidth={STROKE}
+                  fill="none"
+                  // Draw `length` of ring, then skip the rest.
+                  strokeDasharray={`${length} ${CIRCUMFERENCE - length}`}
+                  strokeDashoffset={offset}
+                />
+              );
+            })}
