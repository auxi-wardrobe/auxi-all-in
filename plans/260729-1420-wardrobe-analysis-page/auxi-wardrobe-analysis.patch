--- /dev/null
+++ b/src/screens/wardrobe/analysis/wardrobe-analysis-worn.ts
@@ -0,0 +1,43 @@
+import { WardrobeItem } from '../../../services/wardrobeService';
+import { sortWardrobeItems } from '../wardrobe-sort';
+
+/** How many tiles each of the two worn rows shows. */
+export const WORN_ROW_LIMIT = 8;
+
+export interface WornEntry {
+  item: WardrobeItem;
+  /**
+   * Times worn, or null when the backend hasn't sent `exposure_count` for this
+   * item. Null renders no badge — an absent count is not a zero, and printing
+   * "0" over a shirt the user wears weekly is worse than printing nothing.
+   */
+  count: number | null;
+}
+
+/**
+ * The backend's numeric wear counter. Reached through `WardrobeItem`'s index
+ * signature (so it arrives typed `unknown`) because the field is optional and
+ * not yet in the declared interface — see `wardrobe-sort.ts`, which orders the
+ * grid off the same value.
+ */
+export const exposureCount = (item: WardrobeItem): number | null => {
+  const raw = item.exposure_count;
+  return typeof raw === 'number' && Number.isFinite(raw) ? raw : null;
+};
+
+/**
+ * The most- / least-worn tiles.
+ *
+ * Ordering is delegated to `sortWardrobeItems` rather than re-implemented, so
+ * these rows and the grid's own "Most worn" sort can never disagree about what
+ * "most worn" means — including its fallback to the coarse `usage_frequency`
+ * enum when no numeric count exists.
+ */
+export const pickWornItems = (
+  items: WardrobeItem[],
+  direction: 'most' | 'least',
+  limit: number = WORN_ROW_LIMIT,
+): WornEntry[] =>
+  sortWardrobeItems(items, direction === 'most' ? 'worn_desc' : 'worn_asc')
+    .slice(0, limit)
+    .map(item => ({ item, count: exposureCount(item) }));
