+import { WardrobeItem } from '../../../../services/wardrobeService';
+import { exposureCount, pickWornItems } from '../wardrobe-analysis-worn';
+
+const item = (id: string, fields: Partial<WardrobeItem> = {}): WardrobeItem =>
+  ({ id, ...fields } as WardrobeItem);
+
+const ids = (entries: { item: WardrobeItem }[]) =>
+  entries.map(entry => entry.item.id);
+
+describe('exposureCount', () => {
+  test('reads the numeric backend counter', () => {
+    expect(exposureCount(item('a', { exposure_count: 12 }))).toBe(12);
+    expect(exposureCount(item('b', { exposure_count: 0 }))).toBe(0);
+  });
+
+  // An absent count is not a zero — the row renders no badge rather than
+  // claiming the item has never been worn.
+  test('returns null for missing or non-finite values', () => {
+    expect(exposureCount(item('c'))).toBeNull();
+    expect(exposureCount(item('d', { exposure_count: NaN }))).toBeNull();
+    expect(exposureCount(item('e', { exposure_count: '7' }))).toBeNull();
+  });
+});
+
+describe('pickWornItems', () => {
+  const items = [
+    item('low', { exposure_count: 1 }),
+    item('high', { exposure_count: 99 }),
+    item('mid', { exposure_count: 40 }),
+  ];
+
+  test('most-worn is descending, least-worn ascending', () => {
+    expect(ids(pickWornItems(items, 'most'))).toEqual(['high', 'mid', 'low']);
+    expect(ids(pickWornItems(items, 'least'))).toEqual(['low', 'mid', 'high']);
+  });
+
+  test('respects the row limit', () => {
+    expect(pickWornItems(items, 'most', 2)).toHaveLength(2);
+  });
+
+  test('pairs each item with its count, null when absent', () => {
+    const entries = pickWornItems([item('x', { exposure_count: 5 }), item('y')], 'most');
+    expect(entries.find(e => e.item.id === 'x')?.count).toBe(5);
+    expect(entries.find(e => e.item.id === 'y')?.count).toBeNull();
+  });
+
+  test('does not mutate the input list', () => {
+    const input = [...items];
+    pickWornItems(input, 'most');
+    expect(input.map(i => i.id)).toEqual(items.map(i => i.id));
+  });
+
+  test('empty wardrobe yields no entries', () => {
+    expect(pickWornItems([], 'most')).toEqual([]);
+  });
+});
