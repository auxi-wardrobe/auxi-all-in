index 0000000..2b38341
--- /dev/null
+++ b/src/screens/wardrobe/analysis/wardrobe-analysis-category.ts
@@ -0,0 +1,81 @@
+import {
+  WardrobeItem,
+  matchesCategoryFilter,
+} from '../../../services/wardrobeService';
+
+/**
+ * Category balance — the donut on the Wardrobe Analysis page.
+ *
+ * Buckets are the six garment families the backend's category synonyms already
+ * understand (see `matchesCategoryFilter`), NOT the five user-selectable filter
+ * chips: the grid filter has no Outerwear chip, but a wardrobe full of jackets
+ * still needs to read as outerwear here.
+ */
+export const ANALYSIS_CATEGORY_KEYS = [
+  'one_piece',
+  'outerwear',
+  'top',
+  'bottom',
+  'shoes',
+  'accessory',
+] as const;
+
+export type AnalysisCategoryKey =
+  | (typeof ANALYSIS_CATEGORY_KEYS)[number]
+  | 'other';
+
+export interface CategorySlice {
+  key: AnalysisCategoryKey;
+  count: number;
+  /** Share of ALL items, 0–100, rounded for display. */
+  percent: number;
+}
+
+/**
+ * Classify one item into exactly one bucket. Order is precedence, and it is
+ * deliberate: the synonym lists overlap (a "denim jacket" contains neither
+ * "top" nor "bottom", but a "wrap dress jacket" would match both `one_piece`
+ * and `outerwear`), so the most specific families are tested first and the
+ * first hit wins. Without this an item would be double-counted and the donut
+ * would sum past 100%.
+ */
+export const classifyCategory = (item: WardrobeItem): AnalysisCategoryKey => {
+  const match = ANALYSIS_CATEGORY_KEYS.find(key =>
+    matchesCategoryFilter(item.category, key),
+  );
+  return match ?? 'other';
+};
+
+/**
+ * Count + percentage per bucket, largest first.
+ *
+ * Empty buckets are dropped so the legend only lists what the user actually
+ * owns. `other` (an unrecognised or missing category) is kept when non-empty
+ * rather than silently discarded — dropping it would make the visible slices
+ * sum to less than the centre total with no explanation.
+ *
+ * Percentages are rounded independently and can therefore sum to 99 or 101.
+ * That is intentional: the donut is drawn from raw counts, so the arcs stay
+ * exact and only the printed labels round.
+ */
+export const buildCategoryBalance = (
+  items: WardrobeItem[],
+): CategorySlice[] => {
+  if (items.length === 0) {
+    return [];
+  }
+
+  const counts = new Map<AnalysisCategoryKey, number>();
+  items.forEach(item => {
+    const key = classifyCategory(item);
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  });
+
+  return [...counts.entries()]
+    .map(([key, count]) => ({
+      key,
+      count,
+      percent: Math.round((count / items.length) * 100),
+    }))
+    .sort((a, b) => b.count - a.count || a.key.localeCompare(b.key));
+};
diff --git a/src/screens/wardrobe/analysis/wardrobe-analysis-color.ts b/src/screens/wardrobe/analysis/wardrobe-analysis-color.ts
new file mode 100644
index 0000000..1cccf64
--- /dev/null
+++ b/src/screens/wardrobe/analysis/wardrobe-analysis-color.ts
@@ -0,0 +1,216 @@
+import { WardrobeItem } from '../../../services/wardrobeService';
+
+/**
+ * Colour distribution — the horizontal swatch strip on the Wardrobe Analysis
+ * page.
+ *
+ * Items carry colour in three inconsistent shapes depending on how they were
+ * added (`color_hex` from the auto-tagger, a `dominant_color` name from the
+ * catalog, or a free-form `colors[]` list). This module normalises all three
+ * into one of thirteen named buckets so "navy", "#2b3a67" and "midnight blue"
+ * all read as Blue instead of three one-item slivers.
+ */
+export const COLOR_KEYS = [
+  'black',
+  'white',
+  'gray',
+  'beige',
+  'brown',
+  'red',
+  'orange',
+  'yellow',
+  'green',
+  'teal',
+  'blue',
+  'purple',
+  'pink',
+] as const;
+
+export type ColorKey = (typeof COLOR_KEYS)[number];
+
+export interface ColorShare {
+  key: ColorKey;
+  count: number;
+  /** Share of the items that HAVE a resolvable colour, 0–100. */
+  percent: number;
+}
+
+/** Colour words the backend/catalog uses, mapped onto our buckets. */
+const COLOR_WORDS: Record<ColorKey, string[]> = {
+  black: ['black', 'charcoal', 'onyx'],
+  white: ['white', 'ivory', 'cream', 'off-white'],
+  gray: ['gray', 'grey', 'silver', 'slate'],
+  beige: ['beige', 'tan', 'sand', 'khaki', 'camel', 'nude', 'taupe'],
+  brown: ['brown', 'chocolate', 'coffee', 'mocha', 'espresso'],
+  red: ['red', 'burgundy', 'maroon', 'crimson', 'wine'],
+  orange: ['orange', 'rust', 'terracotta', 'apricot', 'peach'],
+  yellow: ['yellow', 'gold', 'mustard', 'lemon'],
+  green: ['green', 'olive', 'sage', 'emerald', 'mint'],
+  teal: ['teal', 'turquoise', 'aqua', 'cyan'],
+  blue: ['blue', 'navy', 'denim', 'indigo', 'cobalt'],
+  purple: ['purple', 'violet', 'lilac', 'lavender', 'plum'],
+  pink: ['pink', 'rose', 'blush', 'magenta', 'fuchsia'],
+};
+
+const HEX_PATTERN = /^#?([0-9a-f]{3}|[0-9a-f]{6})$/i;
+
+/** Expand `#abc` → `[170, 187, 204]`. Returns null for anything unparseable. */
+const parseHex = (raw: string): [number, number, number] | null => {
+  const match = HEX_PATTERN.exec(raw.trim());
+  if (!match) {
+    return null;
+  }
+  const digits = match[1];
+  const full =
+    digits.length === 3
+      ? digits
+          .split('')
+          .map(d => d + d)
+          .join('')
+      : digits;
+  return [
+    parseInt(full.slice(0, 2), 16),
+    parseInt(full.slice(2, 4), 16),
+    parseInt(full.slice(4, 6), 16),
+  ];
+};
+
+/** Below this chroma a colour is treated as a neutral, not a hue. */
+const NEUTRAL_CHROMA = 0.1;
+/** Warm hues below this chroma read as brown/beige rather than orange/yellow. */
+const EARTH_CHROMA = 0.35;
+
+/**
+ * Bucket an RGB triple: neutrals first, then by hue.
+ *
+ * The achromatic checks run FIRST and are what make the strip useful. Garment
+ * photography is full of near-grey pixels whose hue is numerically well-defined
+ * but visually meaningless (a black tee samples as a very dark blue), so
+ * testing hue first would scatter every neutral across the chromatic buckets
+ * and bury the black/white/grey majority most wardrobes actually have.
+ *
+ * The neutral test uses CHROMA (raw max−min), not HSL saturation. HSL
+ * saturation divides by the distance from the lightness extremes, so it
+ * explodes near black and white — `rgb(250,249,252)` is 1% chroma but 33% HSL
+ * saturation, and a saturation-gated test would call that off-white "purple".
+ * Chroma stays meaningful at every lightness.
+ */
+export const classifyRgb = (r: number, g: number, b: number): ColorKey => {
+  const max = Math.max(r, g, b);
+  const min = Math.min(r, g, b);
+  const delta = max - min;
+  const lightness = (max + min) / 2 / 255;
+  const chroma = delta / 255;
+
+  if (lightness <= 0.14) {
+    return 'black';
+  }
+  if (lightness >= 0.88 && chroma < NEUTRAL_CHROMA) {
+    return 'white';
+  }
+  if (chroma < NEUTRAL_CHROMA) {
+    return 'gray';
+  }
+
+  // Hue in degrees, 0 = red.
+  let hue: number;
+  if (max === r) {
+    hue = ((g - b) / delta) % 6;
+  } else if (max === g) {
+    hue = (b - r) / delta + 2;
+  } else {
+    hue = (r - g) / delta + 4;
+  }
+  hue = (hue * 60 + 360) % 360;
+
+  // Warm, muted and dark reads as brown; warm, muted and light reads as beige.
+  // Both would otherwise be mislabelled orange/yellow.
+  if (hue < 45 && chroma < EARTH_CHROMA) {
+    return lightness < 0.45 ? 'brown' : 'beige';
+  }
+  if (hue < 15 || hue >= 345) return 'red';
+  if (hue < 45) return 'orange';
+  if (hue < 70) return 'yellow';
+  if (hue < 160) return 'green';
+  if (hue < 200) return 'teal';
+  if (hue < 260) return 'blue';
+  if (hue < 310) return 'purple';
+  return 'pink';
+};
+
+const classifyWord = (raw: string): ColorKey | null => {
+  const word = raw.trim().toLowerCase();
+  if (!word) {
+    return null;
+  }
+  const hit = COLOR_KEYS.find(key =>
+    COLOR_WORDS[key].some(candidate => word.includes(candidate)),
+  );
+  return hit ?? null;
+};
+
+/**
+ * One item → one bucket, or null when it carries no usable colour.
+ *
+ * `color_hex` wins because it is measured from the actual image; the name
+ * fields are human/catalog labels and are only consulted as a fallback.
+ */
+export const classifyItemColor = (item: WardrobeItem): ColorKey | null => {
+  if (typeof item.color_hex === 'string') {
+    const rgb = parseHex(item.color_hex);
+    if (rgb) {
+      return classifyRgb(rgb[0], rgb[1], rgb[2]);
+    }
+  }
+
+  const names = [
+    item.dominant_color,
+    ...(Array.isArray(item.colors) ? item.colors : []),
+  ].filter((name): name is string => typeof name === 'string');
+
+  for (const name of names) {
+    const rgb = parseHex(name);
+    if (rgb) {
+      return classifyRgb(rgb[0], rgb[1], rgb[2]);
+    }
+    const word = classifyWord(name);
+    if (word) {
+      return word;
+    }
+  }
+
+  return null;
+};
+
+/**
+ * Buckets with at least one item, largest first.
+ *
+ * Percentages are of the COLOURED population, not of the whole wardrobe, so a
+ * user whose items are half untagged still sees shares that sum to ~100 rather
+ * than a strip that mysteriously only fills half the row.
+ */
+export const buildColorDistribution = (items: WardrobeItem[]): ColorShare[] => {
+  const counts = new Map<ColorKey, number>();
+  let classified = 0;
+
+  items.forEach(item => {
+    const key = classifyItemColor(item);
+    if (!key) {
+      return;
+    }
+    classified += 1;
+    counts.set(key, (counts.get(key) ?? 0) + 1);
+  });
+
+  if (classified === 0) {
+    return [];
+  }
+
+  return [...counts.entries()]
+    .map(([key, count]) => ({
+      key,
+      count,
+      percent: Math.round((count / classified) * 100),
+    }))
+    .sort((a, b) => b.count - a.count || a.key.localeCompare(b.key));
+};
