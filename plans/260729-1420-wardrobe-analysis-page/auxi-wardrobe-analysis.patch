--- /dev/null
+++ b/src/screens/wardrobe/analysis/__tests__/wardrobe-analysis-color.test.ts
@@ -0,0 +1,101 @@
+import { WardrobeItem } from '../../../../services/wardrobeService';
+import {
+  buildColorDistribution,
+  classifyItemColor,
+  classifyRgb,
+} from '../wardrobe-analysis-color';
+
+const item = (id: string, fields: Partial<WardrobeItem> = {}): WardrobeItem =>
+  ({ id, ...fields } as WardrobeItem);
+
+describe('classifyRgb', () => {
+  test.each([
+    [[0, 0, 0], 'black'],
+    [[18, 18, 18], 'black'],
+    [[255, 255, 255], 'white'],
+    [[160, 160, 160], 'gray'],
+    [[200, 40, 40], 'red'],
+    [[240, 200, 40], 'yellow'],
+    [[40, 160, 60], 'green'],
+    [[40, 190, 200], 'teal'],
+    [[43, 58, 103], 'blue'],
+    [[125, 91, 166], 'purple'],
+  ])('%j → %s', (rgb, expected) => {
+    expect(classifyRgb(rgb[0], rgb[1], rgb[2])).toBe(expected);
+  });
+
+  // The whole point of testing lightness/saturation before hue: a near-neutral
+  // has a well-defined but visually meaningless hue.
+  test('near-neutrals stay neutral instead of leaking into a hue bucket', () => {
+    expect(classifyRgb(20, 21, 26)).toBe('black');
+    expect(classifyRgb(250, 249, 252)).toBe('white');
+    expect(classifyRgb(140, 142, 145)).toBe('gray');
+  });
+
+  test('warm and desaturated splits into brown when dark, beige when light', () => {
+    expect(classifyRgb(111, 78, 55)).toBe('brown');
+    expect(classifyRgb(227, 213, 195)).toBe('beige');
+  });
+});
+
+describe('classifyItemColor', () => {
+  test('reads color_hex first, with or without the leading hash', () => {
+    expect(classifyItemColor(item('a', { color_hex: '#121212' }))).toBe('black');
+    expect(classifyItemColor(item('b', { color_hex: '2b3a67' }))).toBe('blue');
+  });
+
+  test('expands 3-digit shorthand hex', () => {
+    expect(classifyItemColor(item('c', { color_hex: '#fff' }))).toBe('white');
+  });
+
+  test('falls back to colour NAMES when no hex is present', () => {
+    expect(classifyItemColor(item('d', { dominant_color: 'navy' }))).toBe('blue');
+    expect(classifyItemColor(item('e', { colors: ['burgundy'] }))).toBe('red');
+  });
+
+  test('a measured hex beats a catalog name', () => {
+    expect(
+      classifyItemColor(
+        item('f', { color_hex: '#121212', dominant_color: 'white' }),
+      ),
+    ).toBe('black');
+  });
+
+  test('unusable colour data yields null, not a guess', () => {
+    expect(classifyItemColor(item('g'))).toBeNull();
+    expect(classifyItemColor(item('h', { color_hex: 'not-a-colour' }))).toBeNull();
+    expect(classifyItemColor(item('i', { dominant_color: 'chartreusey' }))).toBeNull();
+  });
+});
+
+describe('buildColorDistribution', () => {
+  test('no classifiable colours yields an empty strip', () => {
+    expect(buildColorDistribution([item('a'), item('b')])).toEqual([]);
+  });
+
+  // Percentages are of the COLOURED population, so an untagged half of the
+  // wardrobe doesn't silently halve every share.
+  test('percentages are of classified items only', () => {
+    const distribution = buildColorDistribution([
+      item('1', { color_hex: '#121212' }),
+      item('2', { color_hex: '#121212' }),
+      item('3', { color_hex: '#fbfbfb' }),
+      item('4'),
+    ]);
+
+    expect(distribution).toEqual([
+      { key: 'black', count: 2, percent: 67 },
+      { key: 'white', count: 1, percent: 33 },
+    ]);
+  });
+
+  test('buckets are ordered largest first', () => {
+    const distribution = buildColorDistribution([
+      item('1', { dominant_color: 'white' }),
+      item('2', { dominant_color: 'black' }),
+      item('3', { dominant_color: 'black' }),
+      item('4', { dominant_color: 'black' }),
+    ]);
+    expect(distribution.map(share => share.key)).toEqual(['black', 'white']);
+  });
+});
