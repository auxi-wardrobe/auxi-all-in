@@ -0,0 +1,105 @@
+import React from 'react';
+import { ScrollView, StyleSheet, Text, View } from 'react-native';
+import { useTranslation } from 'react-i18next';
+import { theme } from '../../../theme/theme';
+import { ColorKey, ColorShare } from './wardrobe-analysis-color';
+
+const SWATCHES = theme.ds.color.swatch;
+
+/** Perceived brightness (ITU-R BT.601) of a `#rrggbb` token, 0–255. */
+const luminance = (hex: string): number => {
+  const r = parseInt(hex.slice(1, 3), 16);
+  const g = parseInt(hex.slice(3, 5), 16);
+  const b = parseInt(hex.slice(5, 7), 16);
+  return 0.299 * r + 0.587 * g + 0.114 * b;
+};
+
+/**
+ * Label colour for a swatch. Computed from the swatch token rather than
+ * hardcoded per bucket, so adding a colour to `ds.color.swatch` can't ship an
+ * unreadable tile.
+ */
+export const labelColorOn = (key: ColorKey): string =>
+  luminance(SWATCHES[key]) > 150
+    ? theme.colors.figmaTextPrimary
+    : theme.ds.color.white;
+
+/** Tile width scales with share so the strip reads as a distribution. */
+const tileWidth = (percent: number): number =>
+  Math.round(72 + Math.min(percent, 50) * 1.4);
+
+interface ColorDistributionStripProps {
+  distribution: ColorShare[];
+}
+
+/**
+ * Horizontally scrolling colour-distribution strip.
+ *
+ * Every bucket is rendered, however small — the long tail is the interesting
+ * part ("one yellow thing") and truncating it would hide exactly the items a
+ * user is most likely to have forgotten they own.
+ */
+export const ColorDistributionStrip: React.FC<ColorDistributionStripProps> = ({
+  distribution,
+}) => {
+  const { t } = useTranslation();
+
+  return (
+    <ScrollView
+      horizontal
+      showsHorizontalScrollIndicator={false}
+      contentContainerStyle={styles.strip}
+      testID="wardrobe-analysis-color-strip"
+    >
+      {distribution.map(share => {
+        const textColor = labelColorOn(share.key);
+        return (
+          <View
+            key={share.key}
+            testID={`wardrobe-analysis-color-${share.key}`}
+            style={[
+              styles.tile,
+              {
+                width: tileWidth(share.percent),
+                backgroundColor: SWATCHES[share.key],
+              },
+            ]}
+          >
+            <Text style={[styles.percent, { color: textColor }]}>
+              {t('wardrobe.analysis.percent', { percent: share.percent })}
+            </Text>
+            <Text
+              style={[styles.name, { color: textColor }]}
+              numberOfLines={1}
+            >
+              {t(`wardrobe.analysis.color.${share.key}`)}
+            </Text>
+          </View>
+        );
+      })}
+    </ScrollView>
+  );
+};
+
+const styles = StyleSheet.create({
+  strip: {
+    gap: 8,
+    paddingRight: 12,
+  },
+  tile: {
+    height: 96,
+    borderRadius: theme.borderRadius.m,
+    paddingHorizontal: 12,
+    paddingVertical: 10,
+    justifyContent: 'space-between',
+    // Hairline keeps the near-white swatch from vanishing into the page.
+    borderWidth: StyleSheet.hairlineWidth,
+    borderColor: theme.ds.line2,
+  },
+  percent: {
+    ...theme.typography.aliases.uacBodyXsRegular,
+  },
+  name: {
+    ...theme.typography.aliases.poppinsSemiboldXsSm,
+  },
+});
