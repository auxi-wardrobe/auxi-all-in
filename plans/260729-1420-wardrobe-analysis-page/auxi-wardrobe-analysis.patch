+import React from 'react';
+import { ScrollView, StyleSheet, Text, View } from 'react-native';
+import { useTranslation } from 'react-i18next';
+import { LoadableRemoteImage } from '../../../components/features/LoadableRemoteImage';
+import { PressableScale } from '../../../components/primitives/PressableScale';
+import { WardrobeItem } from '../../../services/wardrobeService';
+import { theme } from '../../../theme/theme';
+import { resolveItemImage } from '../../../utils/url';
+import { WornEntry } from './wardrobe-analysis-worn';
+
+const TILE_WIDTH = 92;
+const TILE_HEIGHT = 118;
+
+interface WornItemsRowProps {
+  entries: WornEntry[];
+  onPressItem: (item: WardrobeItem) => void;
+  /** Disambiguates testIDs between the most- and least-worn rows. */
+  testIDPrefix: string;
+}
+
+/**
+ * A horizontally scrolling row of item tiles with their wear count above.
+ *
+ * Deliberately NOT `WardrobeGridTile`: that tile is sized off the 3-column grid
+ * maths and carries the new/less-used/common status pills, none of which mean
+ * anything in a row that is already sorted by wear.
+ */
+export const WornItemsRow: React.FC<WornItemsRowProps> = ({
+  entries,
+  onPressItem,
+  testIDPrefix,
+}) => {
+  const { t } = useTranslation();
+
+  return (
+    <ScrollView
+      horizontal
+      showsHorizontalScrollIndicator={false}
+      contentContainerStyle={styles.row}
+      testID={`${testIDPrefix}-row`}
+    >
+      {entries.map(({ item, count }) => {
+        const imageUrl = resolveItemImage({
+          image_studio: item.image_studio ?? null,
+          image_png: item.image_png ?? null,
+          image_url: item.image_url ?? '',
+        });
+
+        return (
+          <View key={item.id} style={styles.cell}>
+            <Text style={styles.count}>
+              {/* An absent exposure_count is not a zero — see wardrobe-analysis-worn. */}
+              {count === null ? '' : String(count)}
+            </Text>
+
+            <PressableScale
+              style={styles.tile}
+              activeOpacity={0.88}
+              onPress={() => onPressItem(item)}
+              testID={`${testIDPrefix}-item-${item.id}`}
+              accessibilityLabel={
+                item.name || t('wardrobe.list.a11y_item_fallback')
+              }
+            >
+              {imageUrl ? (
+                <LoadableRemoteImage
+                  uri={imageUrl}
+                  cache="force-cache"
+                  resizeMode="contain"
+                />
+              ) : (
+                <View style={styles.fallback}>
+                  <Text style={styles.fallbackText} numberOfLines={2}>
+                    {t('common.no_image')}
+                  </Text>
+                </View>
+              )}
+            </PressableScale>
+          </View>
+        );
+      })}
+    </ScrollView>
+  );
+};
+
+const styles = StyleSheet.create({
+  row: {
+    gap: 8,
+    paddingRight: 12,
+  },
+  cell: {
+    width: TILE_WIDTH,
+  },
+  count: {
+    ...theme.typography.aliases.uacBodyXsRegular,
+    color: theme.colors.figmaTextSecondary,
+    marginBottom: 6,
+    // Reserved even when blank so tiles in a row stay top-aligned whether or
+    // not the backend sent a count.
+    minHeight: 16,
+  },
+  tile: {
+    width: TILE_WIDTH,
+    height: TILE_HEIGHT,
+    borderRadius: theme.borderRadius.m,
+    backgroundColor: theme.colors.figmaCardSurface,
+    overflow: 'hidden',
+  },
+  fallback: {
+    flex: 1,
+    alignItems: 'center',
+    justifyContent: 'center',
+    paddingHorizontal: 8,
+  },
+  fallbackText: {
+    ...theme.typography.aliases.poppinsCaptionXxs,
+    color: theme.colors.figmaTextSecondary,
+    textAlign: 'center',
+  },
+});
