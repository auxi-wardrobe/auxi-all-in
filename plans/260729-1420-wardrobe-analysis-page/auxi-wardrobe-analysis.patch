diff --git a/src/screens/__tests__/WardrobeAnalysisScreen.test.tsx b/src/screens/__tests__/WardrobeAnalysisScreen.test.tsx
new file mode 100644
index 0000000..9bbc507
--- /dev/null
+++ b/src/screens/__tests__/WardrobeAnalysisScreen.test.tsx
@@ -0,0 +1,326 @@
+/**
+ * Wardrobe Analysis screen wiring.
+ *
+ * The derivation maths is covered exhaustively by the unit tests under
+ * `screens/wardrobe/analysis/__tests__/`. What THIS test protects is the wiring
+ * those pure functions hang off: that the screen mounts, that the three
+ * independently-resolving counters land in the right cells, that an empty
+ * wardrobe short-circuits to the empty state instead of dividing by zero, and
+ * that a worn tile navigates.
+ *
+ * Patterns follow WardrobeScreen.test.tsx (react-test-renderer, query by
+ * testID, flush microtasks inside act).
+ */
+import React from 'react';
+import TestRenderer, { act, ReactTestInstance } from 'react-test-renderer';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { WardrobeAnalysisScreen } from '../WardrobeAnalysisScreen';
+
+// ---- mocks ------------------------------------------------------------------
+
+const mockNavigate = jest.fn();
+
+jest.mock('@react-navigation/native', () => {
+  const navigation = {
+    navigate: (...args: unknown[]) => mockNavigate(...args),
+    // Header is stubbed out below, so the back button is never pressed here.
+    goBack: jest.fn(),
+  };
+  return {
+    useNavigation: () => navigation,
+    useIsFocused: () => true,
+  };
+});
+
+// Resolve t() against the real en-EN bundle so a missing analysis key fails
+// here rather than shipping a raw key to the user.
+jest.mock('react-i18next', () => {
+  const en = require('../../translations/en-EN.json').boilerplate;
+  const t = (key: string, opts?: Record<string, unknown>) => {
+    const value = key
+      .split('.')
+      .reduce<unknown>(
+        (acc, part) =>
+          acc && typeof acc === 'object'
+            ? (acc as Record<string, unknown>)[part]
+            : undefined,
+        en,
+      );
+    if (typeof value !== 'string') {
+      return key;
+    }
+    return value.replace(/\{\{(\w+)\}\}/g, (_m, name: string) =>
+      String(opts?.[name] ?? ''),
+    );
+  };
+  const translation = { t };
+  return { useTranslation: () => translation };
+});
+
+const mockGetWardrobeItems = jest.fn();
+const mockListFavourites = jest.fn();
+const mockListCreations = jest.fn();
+
+jest.mock('../../services/wardrobeService', () => {
+  const actual = jest.requireActual('../../services/wardrobeService');
+  return {
+    // The derivation modules call matchesCategoryFilter / getItemUsageFrequency
+    // for real — mocking those would test the mock, not the classification.
+    ...actual,
+    wardrobeService: {
+      getWardrobeItems: (...args: unknown[]) => mockGetWardrobeItems(...args),
+    },
+  };
+});
+
+jest.mock('../../services/favouriteService', () => ({
+  FAVOURITES_QUERY_KEY: ['favourites'],
+  favouriteService: {
+    listFavourites: (...args: unknown[]) => mockListFavourites(...args),
+  },
+}));
+
+jest.mock('../../services/creationsService', () => ({
+  CREATIONS_QUERY_KEY: ['creations'],
+  creationsService: {
+    listCreations: (...args: unknown[]) => mockListCreations(...args),
+  },
+}));
+
+// Cuts the utils/url → apiClient → react-native-keychain import chain.
+jest.mock('../../utils/url', () => ({
+  resolveItemImage: (item?: { image_png?: string | null; image_url?: string }) =>
+    item?.image_png || item?.image_url || null,
+}));
+
+jest.mock('../../services/analytics', () => ({ track: jest.fn() }));
+
+jest.mock('../../components/layout/Header', () => ({
+  Header: { BackTitle: () => null },
+}));
+
+jest.mock('../../components/features/LoadableRemoteImage', () => ({
+  LoadableRemoteImage: () => null,
+}));
+
+// ---- fixtures / helpers -----------------------------------------------------
+
+const ITEMS = [
+  {
+    id: 'a',
+    category: 'top',
+    color_hex: '#121212',
+    style_tags: ['minimal'],
+    exposure_count: 40,
+    image_url: 'https://cdn.example/a.jpg',
+  },
+  {
+    id: 'b',
+    category: 'jeans',
+    color_hex: '#2b3a67',
+    style_tags: ['casual'],
+    exposure_count: 2,
+    image_url: 'https://cdn.example/b.jpg',
+  },
+  {
+    id: 'c',
+    category: 'sneakers',
+    color_hex: '#fbfbfb',
+    style_tags: ['minimal'],
+    exposure_count: 9,
+    image_url: 'https://cdn.example/c.jpg',
+  },
+];
+
+// A single testID matches BOTH the composite element and the host element it
+// renders, so this always returns ≥2 entries for one on-screen node. Assert
+// presence with `.length > 0` and absence with `.length === 0` — never an exact
+// count. `[0]` is the composite, which is where prop handlers live.
+const byTestID = (root: ReactTestInstance, id: string): ReactTestInstance[] =>
+  root.findAll(n => n.props?.testID === id);
+
+/** The rendered string inside a testID'd node, deduped across that same pair. */
+const textOf = (root: ReactTestInstance, id: string): string | undefined => {
+  const node = byTestID(root, id)[0];
+  const text = node
+    ?.findAll(n => typeof n.props?.children === 'string')
+    .map(n => n.props.children as string);
+  return text?.[0];
+};
+
+const liveRenderers: TestRenderer.ReactTestRenderer[] = [];
+
+const makeTestClient = () =>
+  new QueryClient({
+    defaultOptions: {
+      queries: { retry: false, gcTime: 0 },
+      mutations: { retry: false, gcTime: 0 },
+    },
+  });
+
+const renderScreen = async () => {
+  let renderer!: TestRenderer.ReactTestRenderer;
+  await act(async () => {
+    renderer = TestRenderer.create(
+      <QueryClientProvider client={makeTestClient()}>
+        <WardrobeAnalysisScreen />
+      </QueryClientProvider>,
+    );
+  });
+  liveRenderers.push(renderer);
+  // Settle the three independent useQuery fetches plus chained schedulers.
+  await act(async () => {
+    await new Promise<void>(resolve => setTimeout(() => resolve(), 0));
+    await Promise.resolve();
+  });
+  return renderer;
+};
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  mockGetWardrobeItems.mockResolvedValue(ITEMS);
+  mockListFavourites.mockResolvedValue({ total: 35, count: 0, favorites: [] });
+  mockListCreations.mockResolvedValue({ creations: [{ id: 'c1' }, { id: 'c2' }] });
+});
+
+afterEach(() => {
+  liveRenderers.splice(0).forEach(r => {
+    try {
+      act(() => r.unmount());
+    } catch {
+      // already unmounted
+    }
+  });
+});
+
+// =============================================================================
+
+describe('WardrobeAnalysisScreen', () => {
+  it('shows the three headline counters from their separate sources', async () => {
+    const root = (await renderScreen()).root;
+
+    expect(textOf(root, 'wardrobe-analysis-total-items')).toBe('3');
+    expect(textOf(root, 'wardrobe-analysis-total-favourites')).toBe('35');
+    expect(textOf(root, 'wardrobe-analysis-total-creations')).toBe('2');
+  });
+
+  it('renders every section with the donut centred on the item total', async () => {
+    const root = (await renderScreen()).root;
+
+    [
+      'wardrobe-analysis-donut',
+      'wardrobe-analysis-style-profile',
+      'wardrobe-analysis-color-strip',
+      'wardrobe-analysis-most-worn-row',
+      'wardrobe-analysis-least-worn-row',
+    ].forEach(id => {
+      expect(byTestID(root, id).length).toBeGreaterThan(0);
+    });
+
+    expect(textOf(root, 'wardrobe-analysis-donut-total')).toBe('3');
+  });
+
+  it('orders the worn rows by wear count, opposite ways', async () => {
+    const root = (await renderScreen()).root;
+
+    // 'a' is worn 40×, 'b' only 2×.
+    expect(
+      byTestID(root, 'wardrobe-analysis-most-worn-item-a').length,
+    ).toBeGreaterThan(0);
+    expect(
+      byTestID(root, 'wardrobe-analysis-least-worn-item-b').length,
+    ).toBeGreaterThan(0);
+  });
+
+  it('opens ItemDetail from a worn tile and reports which row it came from', async () => {
+    const { track } = require('../../services/analytics');
+    const root = (await renderScreen()).root;
+
+    await act(async () => {
+      byTestID(root, 'wardrobe-analysis-most-worn-item-a')[0].props.onPress();
+    });
+
+    expect(mockNavigate).toHaveBeenCalledWith('ItemDetail', { itemId: 'a' });
+    expect(track).toHaveBeenCalledWith('wardrobe_analysis_item_opened', {
+      item_id: 'a',
+      source: 'most_worn',
+    });
+  });
+
+  // A background refresh of the shared wardrobe cache must not inflate the
+  // view count with events the user never caused.
+  it('reports the screen view once per focus, not once per cache update', async () => {
+    const { track } = require('../../services/analytics');
+    const renderer = await renderScreen();
+
+    const viewEvents = () =>
+      (track as jest.Mock).mock.calls.filter(
+        ([event]: [string]) => event === 'wardrobe_analysis_viewed',
+      );
+
+    expect(viewEvents()).toHaveLength(1);
+    expect(viewEvents()[0][1]).toEqual({ item_count: 3 });
+
+    // Force a re-render with a changed item count, as a cache update would.
+    mockGetWardrobeItems.mockResolvedValue([...ITEMS, { id: 'd', category: 'hat' }]);
+    await act(async () => {
+      renderer.update(
+        <QueryClientProvider client={makeTestClient()}>
+          <WardrobeAnalysisScreen />
+        </QueryClientProvider>,
+      );
+      await Promise.resolve();
+    });
+
+    expect(viewEvents()).toHaveLength(1);
+  });
+
+  it('expands the style insight in place rather than navigating', async () => {
+    const { track } = require('../../services/analytics');
+    const root = (await renderScreen()).root;
+
+    expect(byTestID(root, 'wardrobe-analysis-insight-detail').length).toBe(0);
+
+    await act(async () => {
+      byTestID(root, 'wardrobe-analysis-insight')[0].props.onPress();
+    });
+
+    expect(
+      byTestID(root, 'wardrobe-analysis-insight-detail').length,
+    ).toBeGreaterThan(0);
+    expect(mockNavigate).not.toHaveBeenCalled();
+    expect(track).toHaveBeenCalledWith('wardrobe_analysis_insight_toggled', {
+      expanded: true,
+      style: 'minimal',
+    });
+  });
+
+  // Dividing by zero everywhere is the obvious failure mode for a stats page.
+  it('short-circuits to the empty state on an empty wardrobe', async () => {
+    mockGetWardrobeItems.mockResolvedValue([]);
+
+    const root = (await renderScreen()).root;
+
+    expect(byTestID(root, 'wardrobe-analysis-empty').length).toBeGreaterThan(0);
+    expect(byTestID(root, 'wardrobe-analysis-donut').length).toBe(0);
+    expect(byTestID(root, 'wardrobe-analysis-style-profile').length).toBe(0);
+    // The counters still render — favourites and creations exist independently
+    // of whether the wardrobe does.
+    expect(byTestID(root, 'wardrobe-analysis-summary').length).toBeGreaterThan(
+      0,
+    );
+  });
+
+  it('dashes out the async counters while they are still loading', async () => {
+    // Never resolves — leaves both counters pending past the render.
+    mockListFavourites.mockReturnValue(new Promise(() => {}));
+    mockListCreations.mockReturnValue(new Promise(() => {}));
+
+    const root = (await renderScreen()).root;
+
+    expect(textOf(root, 'wardrobe-analysis-total-favourites')).toBe('—');
+    expect(textOf(root, 'wardrobe-analysis-total-creations')).toBe('—');
+    // The item count comes from the settled wardrobe query, so it is real.
+    expect(textOf(root, 'wardrobe-analysis-total-items')).toBe('3');
+  });
+});
