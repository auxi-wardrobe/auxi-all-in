+import { PressableScale } from '../../../components/primitives/PressableScale';
+import { Icons } from '../../../assets/icons';
+import { theme } from '../../../theme/theme';
+import { StyleKey } from './wardrobe-analysis-style';
+
+interface StyleInsightCardProps {
+  style: StyleKey;
+  expanded: boolean;
+  onToggle: () => void;
+}
+
+/**
+ * The plain-language read on the style profile, sitting directly under the
+ * bars.
+ *
+ * The chevron expands a second paragraph in place instead of navigating: there
+ * is nowhere to navigate TO (the wardrobe grid has no style filter), and a
+ * chevron that opened a dead end would be worse than one that reveals the rest
+ * of the sentence.
+ */
+export const StyleInsightCard: React.FC<StyleInsightCardProps> = ({
+  style,
+  expanded,
+  onToggle,
+}) => {
+  const { t } = useTranslation();
+
+  return (
+    <PressableScale
+      onPress={onToggle}
+      style={styles.card}
+      activeOpacity={0.9}
+      testID="wardrobe-analysis-insight"
+      accessibilityLabel={
+        expanded
+          ? t('wardrobe.analysis.a11y_insight_collapse')
+          : t('wardrobe.analysis.a11y_insight_expand')
+      }
+    >
+      <View style={styles.textWrap}>
+        <Text style={styles.headline}>
+          {t(`wardrobe.analysis.insight.${style}`)}
+        </Text>
+        {expanded ? (
+          <Text style={styles.detail} testID="wardrobe-analysis-insight-detail">
+            {t(`wardrobe.analysis.insight_detail.${style}`)}
+          </Text>
+        ) : null}
+      </View>
+
+      <View style={[styles.chevron, expanded && styles.chevronExpanded]}>
+        <Icons.ChevronRight width={20} height={20} />
+      </View>
+    </PressableScale>
+  );
+};
+
+const styles = StyleSheet.create({
+  card: {
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 12,
+    backgroundColor: theme.colors.figmaSurfaceSoft,
+    borderRadius: theme.ds.radius.sm,
+    paddingVertical: 14,
+    paddingHorizontal: 16,
+  },
+  textWrap: {
+    flex: 1,
+    gap: 6,
+  },
+  headline: {
+    ...theme.typography.aliases.poppinsBodySm,
+    color: theme.colors.figmaTextPrimary,
+  },
+  detail: {
+    ...theme.typography.aliases.uacBodyXsRegular,
+    color: theme.colors.figmaTextSecondary,
+  },
+  chevron: {
+    // Rotating the same chevron keeps one icon doing both states — no second
+    // asset, and the direction always matches what the tap will do.
+    transform: [{ rotate: '0deg' }],
+  },
+  chevronExpanded: {
+    transform: [{ rotate: '90deg' }],
+  },
+});
