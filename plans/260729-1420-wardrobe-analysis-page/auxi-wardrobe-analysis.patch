+const item = (
+  id: string,
+  style_tags: string[] = [],
+  formality_level?: string,
+): WardrobeItem =>
+  ({
+    id,
+    style_tags,
+    ...(formality_level ? { formality_level } : {}),
+  } as WardrobeItem);
+
+describe('matchesStyle', () => {
+  test('matches on substrings so backend variants still land', () => {
+    expect(matchesStyle(item('a', ['minimalist']), 'minimal')).toBe(true);
+    expect(matchesStyle(item('b', ['smart-casual']), 'casual')).toBe(true);
+    expect(matchesStyle(item('c', ['statement-piece']), 'bold')).toBe(true);
+  });
+
+  test('formality_level feeds the classic bucket', () => {
+    expect(matchesStyle(item('d', [], 'formal'), 'classic')).toBe(true);
+  });
+
+  test('matching is case-insensitive', () => {
+    expect(matchesStyle(item('e', ['MINIMAL']), 'minimal')).toBe(true);
+  });
+
+  // These tags describe the user's relationship to the item, not its style.
+  test('control tags never register as a style', () => {
+    expect(matchesStyle(item('f', ['fit:relaxed']), 'casual')).toBe(false);
+    expect(matchesStyle(item('g', ['favorite']), 'minimal')).toBe(false);
+    expect(matchesStyle(item('h', ['less-used']), 'casual')).toBe(false);
+  });
+});
+
+describe('buildStyleProfile', () => {
+  test('empty wardrobe yields no bars', () => {
+    expect(buildStyleProfile([])).toEqual([]);
+  });
+
+  test('always returns all five styles, strongest first', () => {
+    const profile = buildStyleProfile([
+      item('1', ['minimal']),
+      item('2', ['minimal', 'casual']),
+    ]);
+
+    expect(profile).toHaveLength(5);
+    expect(profile[0]).toEqual({ key: 'minimal', count: 2, percent: 100 });
+    expect(profile[1]).toEqual({ key: 'casual', count: 1, percent: 50 });
+    expect(profile.slice(2).every(share => share.count === 0)).toBe(true);
+  });
+
+  // Bars are independent shares, not a partition — one item can be two styles.
+  test('shares may sum past 100 because styles overlap', () => {
+    const profile = buildStyleProfile([item('1', ['minimal', 'casual'])]);
+    const sum = profile.reduce((acc, share) => acc + share.percent, 0);
+    expect(sum).toBe(200);
+  });
+});
+
+describe('dominantStyle', () => {
+  test('picks the strongest non-zero bar', () => {
+    const profile = buildStyleProfile([
+      item('1', ['casual']),
+      item('2', ['casual']),
+      item('3', ['bold']),
+    ]);
+    expect(dominantStyle(profile)).toBe('casual');
+  });
+
+  test('returns null when nothing carries a style signal', () => {
+    expect(dominantStyle(buildStyleProfile([item('1'), item('2')]))).toBeNull();
+    expect(dominantStyle([])).toBeNull();
+  });
+});
