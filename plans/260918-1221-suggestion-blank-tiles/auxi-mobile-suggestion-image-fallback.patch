diff --git a/src/components/features/__tests__/canvas-image-fallback.test.tsx b/src/components/features/__tests__/canvas-image-fallback.test.tsx
new file mode 100644
index 0000000..60abc51
--- /dev/null
+++ b/src/components/features/__tests__/canvas-image-fallback.test.tsx
@@ -0,0 +1,108 @@
+/* eslint-env jest */
+/**
+ * Dead-cutout fallback on the collage/canvas surfaces.
+ *
+ * An onboarding clone copies the SYSTEM catalog item's `processed/` blob URLs.
+ * Those blobs can be dead while the `common_items/` original is still alive, so
+ * picking the display image on string presence alone leaves a HOLE in the
+ * collage — the piece is silently missing from the outfit. Locks the two halves
+ * of the fix: the seed layer carries the ordered chain through untouched, and
+ * the surface walks it on load error.
+ */
+import React from 'react';
+import TestRenderer, { act } from 'react-test-renderer';
+import { seedCanvasLayout, type CollageSeedItem } from '../collage-seed-layout';
+import { OutfitCanvasSurface, type CanvasItemData } from '../OutfitCanvasSurface';
+
+jest.mock('react-i18next', () => ({
+  useTranslation: () => ({ t: (k: string) => k }),
+}));
+
+const DEAD = 'https://x/processed/dead.png';
+const ALIVE = 'https://x/common_items/original.png';
+
+describe('seedCanvasLayout — fallback passthrough', () => {
+  it('carries imageFallbackUris from seed item to output node', () => {
+    const seed: CollageSeedItem = {
+      id: 'tee',
+      imageUri: DEAD,
+      imageFallbackUris: [ALIVE],
+      category: 'Top',
+    };
+    const [out] = seedCanvasLayout([seed], 382);
+
+    expect(out.imageSource).toEqual({ uri: DEAD });
+    expect(out.imageFallbackUris).toEqual([ALIVE]);
+  });
+
+  it('layout geometry is unchanged by the extra field', () => {
+    const withFallback = seedCanvasLayout(
+      [{ id: 'tee', imageUri: DEAD, imageFallbackUris: [ALIVE], category: 'Top' }],
+      382,
+    );
+    const without = seedCanvasLayout(
+      [{ id: 'tee', imageUri: DEAD, category: 'Top' }],
+      382,
+    );
+
+    const geometry = (o: (typeof withFallback)[number]) => [o.x, o.y, o.width, o.height, o.zIndex];
+    expect(geometry(withFallback[0])).toEqual(geometry(without[0]));
+  });
+});
+
+const item = (overrides: Partial<CanvasItemData> = {}): CanvasItemData => ({
+  id: 'i1',
+  imageSource: { uri: DEAD },
+  imageFallbackUris: [ALIVE],
+  x: 0,
+  y: 0,
+  zIndex: 1,
+  width: 100,
+  height: 100,
+  ...overrides,
+});
+
+const renderSurface = (data: CanvasItemData) => {
+  let r!: TestRenderer.ReactTestRenderer;
+  act(() => {
+    r = TestRenderer.create(
+      <OutfitCanvasSurface
+        items={[data]}
+        width={382}
+        height={509}
+        onPositionChange={() => {}}
+      />,
+    );
+  });
+  return r;
+};
+
+const imageNode = (r: TestRenderer.ReactTestRenderer) =>
+  r.root.find(n => typeof n.props?.source?.uri === 'string');
+
+describe('OutfitCanvasSurface — dead cutout does not leave a hole', () => {
+  it('retires the dead cutout and renders the live original', () => {
+    const r = renderSurface(item());
+    expect(imageNode(r).props.source.uri).toBe(DEAD);
+
+    act(() => {
+      imageNode(r).props.onError();
+    });
+    expect(imageNode(r).props.source.uri).toBe(ALIVE);
+  });
+
+  it('a require()d local asset is rendered as-is with no onError handler', () => {
+    // A bundled asset resolves to a number, not a { uri } object — it cannot
+    // 404, so it must not be routed through the fallback chain.
+    const local = 42 as unknown as CanvasItemData['imageSource'];
+    const r = renderSurface(item({ imageSource: local, imageFallbackUris: undefined }));
+
+    const img = r.root.find(n => n.props?.source === local);
+    expect(img.props.onError).toBeUndefined();
+  });
+
+  it('no fallbacks supplied → still renders the single source', () => {
+    const r = renderSurface(item({ imageFallbackUris: undefined }));
+    expect(imageNode(r).props.source.uri).toBe(DEAD);
+  });
+});
