+
+// ── Garment image fallback (dead `processed/` blob recovery) ───────────────
+// A wardrobe item's display image is an ORDERED chain (studio → cutout →
+// original). An onboarding clone copies the SYSTEM catalog item's `processed/`
+// blob URLs, and those blobs can be dead while the `common_items/` original
+// still loads — so the chain is walked on load error (`useImageFallback`).
+//
+// This event is the rate at which that recovery fires. It is the signal that
+// says whether the rotten SYSTEM `processed/` catalog data is still costing a
+// failed request per tile — i.e. whether the backend repair
+// (`repair_dead_processed_images.py` + `backfill_cutout_images.py`) has
+// actually landed in prod. `recovered: false` is the worse case: nothing in
+// the chain loaded, so the user sees a blank tile.
+//
+// NO PII: the URL is NEVER shipped. Only the storage-prefix token is sent, and
+// the URL is used solely as the per-session dedup key.
+
+/** Coarse storage bucket for an image URL — a path token, never the URL. */
+const storageBucket = (url: string): string => {
+  if (url.includes('/common_items/')) return 'common_items';
+  if (url.includes('/processed/')) return 'processed';
+  if (url.includes('/uploads/')) return 'uploads';
+  if (url.includes('/tryon/')) return 'tryon';
+  if (url.includes('/bodies/')) return 'bodies';
+  return 'other';
+};
+
+/**
+ * Per-session dedup. The same dead URL is shared by every clone of a catalog
+ * item and re-renders on every grid scroll, so without this one rotten blob
+ * would fire hundreds of events per session and drown the signal. Module-level
+ * so it spans re-mounts and resets on app restart (per-session semantics),
+ * mirroring `seenRecommendations`.
+ */
+const seenFailedImages = new Set<string>();
+
+/**
+ * A garment image URL failed to load and the chain fell back. Fire at most
+ * once per failed URL per session — never call `track('item_image_fallback_used')`
+ * directly. `recoveredUri` is undefined when every candidate is exhausted.
+ */
+export const trackImageFallbackUsed = (
+  failedUri: string,
+  recoveredUri?: string,
+): void => {
+  if (!failedUri || seenFailedImages.has(failedUri)) {
+    return;
+  }
+  seenFailedImages.add(failedUri);
+  track('item_image_fallback_used', {
+    failed_bucket: storageBucket(failedUri),
+    recovered: !!recoveredUri,
+    ...(recoveredUri ? { recovered_bucket: storageBucket(recoveredUri) } : {}),
+  });
+};
