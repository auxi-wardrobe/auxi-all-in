diff --git a/src/screens/HomeScreen/__tests__/garment-preview.render.test.tsx b/src/screens/HomeScreen/__tests__/garment-preview.render.test.tsx
index 3d925f8..0807d73 100644
--- a/src/screens/HomeScreen/__tests__/garment-preview.render.test.tsx
+++ b/src/screens/HomeScreen/__tests__/garment-preview.render.test.tsx
@@ -128,3 +128,45 @@ test('pinned item resolved from the wardrobe (R5 path) still resolves its status
   });
   expect(badgeTestIDs(r)).toEqual([]);
 });
+
+/**
+ * The suggestion tile rendered blank while item detail showed the same garment
+ * fine: an onboarding clone copies the SYSTEM catalog item's `processed/` blob
+ * URLs, those blobs were deleted, and this tile picked the winner on string
+ * presence with no `onError` recovery. Item detail already walked the ordered
+ * chain, hence the asymmetry the CEO saw. Locks the chain + retire-on-error.
+ */
+const imageNode = (r: TestRenderer.ReactTestRenderer) =>
+  r.root.find(
+    n => typeof n.props?.source?.uri === 'string' && !!n.props.onError,
+  );
+
+test('dead cutout falls back to the still-alive original instead of rendering blank', () => {
+  const r = render({
+    ...baseItem,
+    image_url: 'https://x/common_items/original.png',
+    image_png: 'https://x/processed/dead.png',
+  });
+
+  // Best candidate first.
+  expect(imageNode(r).props.source.uri).toBe('https://x/processed/dead.png');
+
+  // It 404s — the tile retires it and shows the original, not a blank View.
+  act(() => {
+    imageNode(r).props.onError();
+  });
+  expect(imageNode(r).props.source.uri).toBe(
+    'https://x/common_items/original.png',
+  );
+});
+
+test('every candidate dead → no image node left, falls through to the blank tile', () => {
+  const r = render({ ...baseItem, image_url: 'https://x/only.png' });
+
+  act(() => {
+    imageNode(r).props.onError();
+  });
+  expect(
+    r.root.findAll(n => typeof n.props?.source?.uri === 'string'),
+  ).toHaveLength(0);
+});
