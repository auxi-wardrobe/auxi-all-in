+// `shouldColdStart` / `pickTodaysSheets` reach the clock through
+// `isPersistedStale`'s `now = new Date()` default — they take no `now`
+// parameter to thread `NOW` into. Without a frozen clock the fixtures above
+// are "today" only on 2026-09-12, so the two tests that exercise the
+// persisted-blob branch through those two functions started failing the day
+// after they were written. Freeze the clock to `NOW` so this suite asserts
+// the precedence rules, not the calendar.
+beforeAll(() => {
+  jest.useFakeTimers().setSystemTime(NOW);
+});
+
+afterAll(() => {
+  jest.useRealTimers();
+});
