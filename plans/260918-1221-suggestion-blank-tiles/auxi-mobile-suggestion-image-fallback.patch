diff --git a/src/services/__tests__/image-fallback-analytics.test.ts b/src/services/__tests__/image-fallback-analytics.test.ts
new file mode 100644
index 0000000..59b89ef
--- /dev/null
+++ b/src/services/__tests__/image-fallback-analytics.test.ts
@@ -0,0 +1,101 @@
+/* eslint-env jest */
+/**
+ * `item_image_fallback_used` — the rate at which a garment image chain has to
+ * recover from a dead URL. This is the signal that says whether the rotten
+ * SYSTEM `processed/` catalog blobs are still costing a failed request per
+ * tile, so its hygiene matters:
+ *   - NO PII: the URL is never shipped, only its storage-prefix token,
+ *   - deduped per failed URL per session, because one rotten catalog blob is
+ *     shared by every clone and re-renders on every grid scroll.
+ *
+ * Asserts through the `console.info` dev log, the same seam
+ * `analytics.test.ts` uses to read event name + props.
+ */
+type AnalyticsModule = typeof import('../analytics');
+
+const DEAD = 'https://cdn.test/processed/abc123.png';
+const ALIVE = 'https://cdn.test/common_items/TOP_W_U/SYS_L2_TEE.png';
+
+let consoleSpy: jest.SpyInstance;
+
+// Fresh singleton per test — the dedup Set lives in module scope.
+const loadAnalytics = (): AnalyticsModule => require('../analytics');
+
+const fallbackCalls = () =>
+  consoleSpy.mock.calls.filter(
+    call => call[0] === 'analytics.track' && call[1] === 'item_image_fallback_used',
+  );
+
+beforeEach(() => {
+  jest.resetModules();
+  consoleSpy = jest.spyOn(console, 'info').mockImplementation();
+});
+
+afterEach(() => {
+  consoleSpy.mockRestore();
+});
+
+describe('trackImageFallbackUsed', () => {
+  it('reports the storage buckets, never the URL', () => {
+    loadAnalytics().trackImageFallbackUsed(DEAD, ALIVE);
+
+    expect(fallbackCalls()).toHaveLength(1);
+    expect(fallbackCalls()[0][2]).toEqual({
+      failed_bucket: 'processed',
+      recovered: true,
+      recovered_bucket: 'common_items',
+    });
+
+    // The URL itself must not leak through any property.
+    const props = JSON.stringify(fallbackCalls()[0][2]);
+    expect(props).not.toContain('cdn.test');
+    expect(props).not.toContain('abc123');
+    expect(props).not.toContain('SYS_L2_TEE');
+  });
+
+  it('marks the blank-tile case — nothing in the chain loaded', () => {
+    loadAnalytics().trackImageFallbackUsed(DEAD);
+
+    expect(fallbackCalls()[0][2]).toEqual({
+      failed_bucket: 'processed',
+      recovered: false,
+    });
+    // `recovered_bucket` is omitted, never null / undefined / "".
+    expect(fallbackCalls()[0][2]).not.toHaveProperty('recovered_bucket');
+  });
+
+  it('fires once per failed URL per session — a shared rotten blob cannot flood', () => {
+    const { trackImageFallbackUsed } = loadAnalytics();
+    trackImageFallbackUsed(DEAD, ALIVE);
+    trackImageFallbackUsed(DEAD, ALIVE);
+    trackImageFallbackUsed(DEAD, ALIVE);
+
+    expect(fallbackCalls()).toHaveLength(1);
+  });
+
+  it('still counts a different dead URL', () => {
+    const { trackImageFallbackUsed } = loadAnalytics();
+    trackImageFallbackUsed(DEAD, ALIVE);
+    trackImageFallbackUsed('https://cdn.test/processed/other.png', ALIVE);
+
+    expect(fallbackCalls()).toHaveLength(2);
+  });
+
+  it('classifies a user upload distinctly from the catalog', () => {
+    loadAnalytics().trackImageFallbackUsed(
+      'https://cdn.test/uploads/mine.png',
+      'https://cdn.test/nowhere/x.png',
+    );
+
+    expect(fallbackCalls()[0][2]).toMatchObject({
+      failed_bucket: 'uploads',
+      recovered_bucket: 'other',
+    });
+  });
+
+  it('ignores an empty URL', () => {
+    loadAnalytics().trackImageFallbackUsed('', ALIVE);
+
+    expect(fallbackCalls()).toHaveLength(0);
+  });
+});
